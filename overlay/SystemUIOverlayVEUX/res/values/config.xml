<resources>
    <!-- Doze: does this device support STATE_DOZE?  -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Preferred max refresh rate at keyguard, if supported by the display. -->
    <integer name="config_keyguardMaxRefreshRate">60</integer>

    <!-- A path similar to frameworks/base/core/res/res/values/config.xml
      config_mainBuiltInDisplayCutout that describes a path larger than the exact path of a outer
      display cutout. If present as well as config_enableDisplayCutoutProtection is set to true,
      then SystemUI will draw this "protection path" instead of the display cutout path that is
      normally used for anti-aliasing.

      This path will only be drawn when the front-facing camera turns on, otherwise the main
      DisplayCutout path will be rendered
       -->
    <string name="config_frontBuiltInDisplayCutoutProtection" translatable="false">M 540,0 m -36,52 a 36,36 0 1,0 72,0 a 36,36 0 1,0 -72,0</string>

    <!-- ID for the camera of outer display that needs extra protection -->
    <string name="config_protectedCameraId" translatable="false">1</string>

    <!--  Flag to turn on the rendering of the above path or not  -->
    <bool name="config_enableDisplayCutoutProtection">true</bool>

    <!-- Receiver-only WFD: remove the Cast sender tile from defaults and the tile editor. -->
    <bool name="config_show_cast_sender">false</bool>
    <string name="quick_settings_tiles_default" translatable="false">internet,bt,dnd,flashlight,airplane,rotation,wallet,alarm,controls,screenrecord,battery,custom(com.android.wfdreceiver/.ReceiverTileService)</string>
    <string name="quick_settings_tiles_default_split" translatable="false">wifi,bt,cell,dnd,wallet,airplane,rotation,flashlight,battery,alarm,controls,screenrecord,custom(com.android.wfdreceiver/.ReceiverTileService)</string>
    <string-array name="quick_settings_large_tiles_default_split" translatable="false">
        <item>wifi</item>
        <item>bt</item>
        <item>cell</item>
        <item>dnd</item>
        <item>wallet</item>
    </string-array>
    <string name="quick_settings_tiles_stock" translatable="false">internet,wifi,bt,flashlight,dnd,modes_dnd,alarm,airplane,nfc,controls,wallet,rotation,battery,screenrecord,mictoggle,cameratoggle,location,hotspot,inversion,saver,dark,work,night,reverse,reduce_brightness,qr_code_scanner,onehanded,color_correction,font_scaling,record_issue,hearing_devices,notes,desktopeffects,cell,caffeine,heads_up,sync,ambient_display,usb_tether,aod,powershare,reading_mode,vpn,auto_brightness,data_switch,custom(com.android.wfdreceiver/.ReceiverTileService)</string>
</resources>
