// Built-in Miracast sink UI for the Qualcomm WFD stack shipped by veux/peux.
android_app {
    name: "WfdReceiver",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,
}

prebuilt_etc {
    name: "privapp-permissions-wfdreceiver",
    src: "permissions/privapp-permissions-wfdreceiver.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "default-permissions-wfdreceiver",
    src: "permissions/default-permissions-wfdreceiver.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
